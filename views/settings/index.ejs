<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Settings - EMS Pro</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
<div class="wrapper">
  <%- include('../partials/sidebar') %>
  <div class="main-content">
    <%- include('../partials/topbar') %>
    <div class="content-area">
      <div class="page-header">
        <div class="page-header-left">
          <h1>Settings <span>Panel</span></h1>
          <p>System shortcuts and account overview.</p>
        </div>
      </div>

      <div class="settings-grid">
        <a href="/register" class="settings-tile"><i class="fas fa-user-shield"></i><strong>Create Admin</strong><span>Add another password protected admin.</span></a>
        <a href="/departments" class="settings-tile"><i class="fas fa-building"></i><strong>Manage Departments</strong><span><%= deptCount %> department(s) configured.</span></a>
        <a href="/reports" class="settings-tile"><i class="fas fa-chart-column"></i><strong>Open Reports</strong><span>Review payroll and team summary.</span></a>
        <form action="/logout" method="POST" class="settings-tile danger-tile"><button type="submit"><i class="fas fa-right-from-bracket"></i><strong>Logout</strong><span>Sign out and lock the application</span></button></form>
      </div>

      <div class="card-box mt-4">
        <div class="box-header"><h5 class="box-title">Current Admin</h5></div>
        <div class="profile-row">
          <div class="admin-avatar"><%= currentAdmin ? currentAdmin.name.substring(0,2).toUpperCase() : 'AD' %></div>
          <div><strong><%= currentAdmin ? currentAdmin.name : 'Admin' %></strong><p><%= currentAdmin ? currentAdmin.email : '' %></p></div>
          <span class="dept-tag"><%= adminCount %> admin account(s)</span>
        </div>
      </div>
    </div>
  </div>
</div>
<script src="/js/script.js"></script>
</body>
</html>
