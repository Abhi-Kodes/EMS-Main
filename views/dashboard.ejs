<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Dashboard — EMS Pro</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
<div class="wrapper">

  <%- include('partials/sidebar') %>

  <div class="main-content">
    <%- include('partials/topbar') %>

    <div class="content-area">

      <!-- Page Header -->
      <div class="page-header">
        <div class="page-header-left">
          <h1>Dashboard <span>Overview</span></h1>
          <p>Welcome back, Admin! Here's today's summary..</p>
        </div>
        <a href="/employees/add" class="btn btn-primary">
          <i class="fas fa-plus"></i> New Employee
        </a>
      </div>

      <!-- Stat Cards -->
      <div class="row g-4 mb-4">
        <div class="col-xl-3 col-md-6">
          <div class="stat-card card-indigo">
            <div class="stat-icon"><i class="fas fa-users"></i></div>
            <div class="stat-info">
              <h3><%= totalEmp %></h3>
              <p>Total Employees</p>
            </div>
            <div class="stat-trend"><i class="fas fa-arrow-up"></i> All time</div>
            <div class="stat-bg"><i class="fas fa-users"></i></div>
          </div>
        </div>

        <div class="col-xl-3 col-md-6">
          <div class="stat-card card-emerald">
            <div class="stat-icon"><i class="fas fa-user-check"></i></div>
            <div class="stat-info">
              <h3><%= activeEmp %></h3>
              <p>Active Employees</p>
            </div>
            <div class="stat-trend"><i class="fas fa-check"></i> Currently working</div>
            <div class="stat-bg"><i class="fas fa-user-check"></i></div>
          </div>
        </div>

        <div class="col-xl-3 col-md-6">
          <div class="stat-card card-amber">
            <div class="stat-icon"><i class="fas fa-building"></i></div>
            <div class="stat-info">
              <h3><%= deptCount %></h3>
              <p>Departments</p>
            </div>
            <div class="stat-trend"><i class="fas fa-layer-group"></i> Total teams</div>
            <div class="stat-bg"><i class="fas fa-building"></i></div>
          </div>
        </div>

        <div class="col-xl-3 col-md-6">
          <div class="stat-card card-rose">
            <div class="stat-icon"><i class="fas fa-indian-rupee-sign"></i></div>
            <div class="stat-info">
              <h3>₹<%= (totalSalary/100000).toFixed(1) %>L</h3>
              <p>Monthly Payroll</p>
            </div>
            <div class="stat-trend"><i class="fas fa-chart-line"></i> Active employees</div>
            <div class="stat-bg"><i class="fas fa-indian-rupee-sign"></i></div>
          </div>
        </div>
      </div>

      <!-- Charts + Recent Table -->
      <div class="row g-4 mb-4">

        <!-- Department Chart -->
        <div class="col-lg-4">
          <div class="card-box">
            <div class="box-header">
              <h5 class="box-title">Department Distribution</h5>
            </div>
            <canvas id="deptChart" height="240"></canvas>
            <div class="mt-3" id="deptLegend"></div>
          </div>
        </div>

        <!-- Recent Employees -->
        <div class="col-lg-8">
          <div class="card-box">
            <div class="box-header">
              <h5 class="box-title">Recent Employees</h5>
              <a href="/employees" class="box-action">View All →</a>
            </div>
            <div style="overflow-x:auto;">
              <table class="recent-table">
                <thead>
                  <tr>
                    <th>Employee</th>
                    <th>ID</th>
                    <th>Department</th>
                    <th>Salary</th>
                    <th>Status</th>
                  </tr>
                </thead>
                <tbody>
                  <% recentEmp.forEach(emp => { %>
                  <tr>
                    <td>
                      <div style="display:flex;align-items:center;gap:10px;">
                        <div class="emp-avatar" data-name="<%= emp.first_name %> <%= emp.last_name %>" style="width:34px;height:34px;border-radius:9px;display:flex;align-items:center;justify-content:center;font-size:12px;font-weight:700;color:white;background:#6366f1;flex-shrink:0;"></div>
                        <div>
                          <div style="font-weight:600;font-size:13px;"><%= emp.first_name %> <%= emp.last_name %></div>
                          <div style="font-size:11.5px;color:#64748b;"><%= emp.designation || '—' %></div>
                        </div>
                      </div>
                    </td>
                    <td><span class="emp-id-badge"><%= emp.emp_id %></span></td>
                    <td><span class="dept-tag"><%= emp.dept_name || 'N/A' %></span></td>
                    <td><span class="salary-text">₹<%= emp.salary ? Number(emp.salary).toLocaleString('en-IN') : '0' %></span></td>
                    <td><span class="status-pill <%= emp.status %>"><%= emp.status %></span></td>
                  </tr>
                  <% }) %>
                  <% if (!recentEmp.length) { %>
                  <tr><td colspan="5" style="text-align:center;padding:30px;color:#94a3b8;">Koi employee nahi mila</td></tr>
                  <% } %>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>

      <!-- Dept Stats Row -->
      <div class="row g-4">
        <% deptStats.forEach((dept, i) => { %>
        <div class="col-xl-<%= Math.floor(12/deptStats.length) || 2 %> col-md-4 col-6">
          <div class="card-box" style="padding:18px;">
            <div style="display:flex;align-items:center;gap:10px;margin-bottom:8px;">
              <div style="width:36px;height:36px;border-radius:9px;background:linear-gradient(135deg,#6366f1,#818cf8);display:flex;align-items:center;justify-content:center;font-size:14px;color:white;flex-shrink:0;">
                <i class="fas fa-building"></i>
              </div>
              <div style="font-size:12.5px;font-weight:600;color:#1e293b;line-height:1.3;"><%= dept.name %></div>
            </div>
            <div style="font-size:26px;font-weight:800;color:#6366f1;"><%= dept.emp_count %></div>
            <div style="font-size:11.5px;color:#94a3b8;font-weight:500;">employees</div>
          </div>
        </div>
        <% }) %>
      </div>

    </div><!-- /content-area -->
  </div><!-- /main-content -->
</div><!-- /wrapper -->

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script src="/js/script.js"></script>
<script>
  // Department Doughnut Chart
  const deptColors = ['#6366f1','#22c55e','#f59e0b','#ef4444','#06b6d4','#8b5cf6'];
  const deptLabels = <%- JSON.stringify(deptStats.map(function(d){ return d.name; })) %>;
  const deptData   = <%- JSON.stringify(deptStats.map(function(d){ return d.emp_count; })) %>;

  new Chart(document.getElementById('deptChart'), {
    type: 'doughnut',
    data: {
      labels: deptLabels,
      datasets: [{
        data: deptData,
        backgroundColor: deptColors,
        borderWidth: 3,
        borderColor: '#fff',
        hoverBorderWidth: 0
      }]
    },
    options: {
      plugins: {
        legend: { display: false }
      },
      cutout: '68%',
      animation: { duration: 800 }
    }
  });

  // Custom legend
  const legend = document.getElementById('deptLegend');
  deptLabels.forEach((label, i) => {
    legend.innerHTML += `
      <div style="display:flex;align-items:center;gap:8px;margin-bottom:7px;">
        <div style="width:10px;height:10px;border-radius:3px;background:${deptColors[i]};flex-shrink:0;"></div>
        <span style="font-size:12.5px;color:#1e293b;font-weight:500;flex:1;">${label}</span>
        <span style="font-size:12.5px;font-weight:700;color:#64748b;">${deptData[i]}</span>
      </div>
    `;
  });
</script>
</body>
</html>
