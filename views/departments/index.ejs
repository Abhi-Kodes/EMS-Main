<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Departments - EMS Pro</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
<div class="wrapper">
  <%- include('../partials/sidebar') %>
  <div class="main-content">
    <%- include('../partials/topbar') %>
    <div class="content-area">
      <div class="page-header">
        <div class="page-header-left">
          <h1>Departments <span>Workspace</span></h1>
          <p>Create, edit and track teams from one place.</p>
        </div>
      </div>

      <div class="row g-4">
        <div class="col-lg-4">
          <div class="form-wrapper">
            <div class="form-header">
              <div class="form-header-icon"><i class="fas fa-building-circle-check"></i></div>
              <div><h4>Add Department</h4><p>Add a new team here </p></div>
            </div>
            <form action="/departments" method="POST" class="form-body">
              <label class="form-label">Department Name <span class="req">*</span></label>
              <input name="name" class="form-control" placeholder="Engineering" required>
              <label class="form-label mt-3">Description</label>
              <textarea name="description" class="form-control" placeholder="Team purpose"></textarea>
              <button class="btn btn-primary mt-3" type="submit"><i class="fas fa-plus"></i> Add Department</button>
            </form>
          </div>
        </div>

        <div class="col-lg-8">
          <div class="table-wrapper">
            <div class="table-toolbar">
              <span class="table-toolbar-title"><i class="fas fa-layer-group"></i> Department List</span>
              <span class="text-muted"><%= departments.length %> department(s)</span>
            </div>
            <div class="department-grid">
              <% departments.forEach(dept => { %>
                <div class="department-card">
                  <form action="/departments/<%= dept.id %>?_method=PUT" method="POST" id="deptUpdate<%= dept.id %>"></form>
                  <div class="department-card-top">
                    <div class="department-icon"><i class="fas fa-building"></i></div>
                    <div class="department-stats">
                      <strong><%= dept.emp_count %></strong>
                      <span>employees</span>
                    </div>
                  </div>
                  <input name="name" class="form-control" value="<%= dept.name %>" required form="deptUpdate<%= dept.id %>">
                  <textarea name="description" class="form-control mt-2" form="deptUpdate<%= dept.id %>"><%= dept.description || '' %></textarea>
                  <div class="department-meta">
                    Payroll: Rs <%= Number(dept.salary_total || 0).toLocaleString('en-IN') %>
                  </div>
                  <div class="department-actions">
                    <button class="btn btn-primary btn-sm" type="submit" form="deptUpdate<%= dept.id %>"><i class="fas fa-save"></i> Save</button>
                    <form action="/departments/<%= dept.id %>?_method=DELETE" method="POST" class="delete-form" data-name="<%= dept.name %> department">
                      <button class="btn btn-danger btn-sm" type="submit"><i class="fas fa-trash"></i></button>
                    </form>
                  </div>
                </div>
              <% }) %>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
<script src="/js/script.js"></script>
</body>
</html>
