<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Employees — EMS Pro</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
<div class="wrapper">

  <%- include('../partials/sidebar') %>

  <div class="main-content">
    <%- include('../partials/topbar') %>

    <div class="content-area">

      <!-- Header -->
      <div class="page-header">
        <div class="page-header-left">
          <h1>All <span>Employees</span></h1>
          <p>Total <%= employees.length %> employee(s) found</p>
        </div>
        <a href="/employees/add" class="btn btn-primary">
          <i class="fas fa-plus"></i> Add Employee
        </a>
      </div>

      <!-- Table Wrapper -->
      <div class="table-wrapper">

        <!-- Toolbar: Filter -->
        <div class="table-toolbar">
          <span class="table-toolbar-title">
            <i class="fas fa-users" style="color:#6366f1;margin-right:7px;"></i>
            Employee Directory
          </span>
          <div class="table-toolbar-actions">
            <form action="/employees/search" method="GET" style="display:flex;gap:8px;flex-wrap:wrap;">
              <div class="search-box" style="padding:6px 12px;">
                <i class="fas fa-search"></i>
                <input type="text" name="q" value="<%= search %>" placeholder="Name, ID, email..." id="liveSearch" style="width:160px;" autocomplete="off">
              </div>

              <select name="dept" class="filter-select">
                <option value="">All Departments</option>
                <% departments.forEach(d => { %>
                  <option value="<%= d.id %>"><%= d.name %></option>
                <% }) %>
              </select>

              <select name="status" class="filter-select">
                <option value="">All Status</option>
                <option value="active">Active</option>
                <option value="inactive">Inactive</option>
              </select>

              <button type="submit" class="btn btn-primary btn-sm">
                <i class="fas fa-filter"></i> Filter
              </button>

              <% if (search) { %>
                <a href="/employees" class="btn btn-secondary btn-sm">
                  <i class="fas fa-times"></i> Clear
                </a>
              <% } %>
            </form>
          </div>
        </div>

        <!-- Table -->
        <% if (employees.length > 0) { %>
        <div style="overflow-x:auto;">
          <table class="emp-table">
            <thead>
              <tr>
                <th>#</th>
                <th>Employee</th>
                <th>Emp ID</th>
                <th>Department</th>
                <th>Designation</th>
                <th>Salary</th>
                <th>Join Date</th>
                <th>Status</th>
                <th style="text-align:center;">Actions</th>
              </tr>
            </thead>
            <tbody>
              <% employees.forEach((emp, i) => { %>
              <tr class="emp-row-link" data-href="/employees/view/<%= emp.id %>">
                <td style="color:#94a3b8;font-weight:600;font-size:12px;"><%= i + 1 %></td>
                <td>
                  <div class="emp-name-cell">
                    <div class="emp-avatar" data-name="<%= emp.first_name %> <%= emp.last_name %>"></div>
                    <div>
                      <div class="emp-name"><%= emp.first_name %> <%= emp.last_name %></div>
                      <div class="emp-email"><%= emp.email %></div>
                    </div>
                  </div>
                </td>
                <td><span class="emp-id-badge"><%= emp.emp_id %></span></td>
                <td><span class="dept-tag"><%= emp.dept_name || '—' %></span></td>
                <td style="color:#64748b;"><%= emp.designation || '—' %></td>
                <td><span class="salary-text">₹<%= emp.salary ? Number(emp.salary).toLocaleString('en-IN') : '0' %></span></td>
                <td style="color:#64748b;font-size:12.5px;">
                  <%= emp.join_date ? new Date(emp.join_date).toLocaleDateString('en-IN', {day:'2-digit',month:'short',year:'numeric'}) : '—' %>
                </td>
                <td>
                  <button
                    class="status-pill <%= emp.status %>"
                    data-id="<%= emp.id %>"
                    data-name="<%= emp.first_name %> <%= emp.last_name %>"
                    title="Click to toggle status"
                  >
                    <%= emp.status %>
                  </button>
                </td>
                <td>
                  <div class="action-btns" style="justify-content:center;">
                    <a href="/employees/view/<%= emp.id %>" class="btn-icon btn-view" title="View">
                      <i class="fas fa-eye"></i>
                    </a>
                    <a href="/employees/edit/<%= emp.id %>" class="btn-icon btn-edit" title="Edit">
                      <i class="fas fa-pen"></i>
                    </a>
                    <form
                      action="/employees/delete/<%= emp.id %>?_method=DELETE"
                      method="POST"
                      class="delete-form"
                      data-name="<%= emp.first_name %> <%= emp.last_name %>"
                    >
                      <button type="submit" class="btn-icon btn-delete" title="Delete">
                        <i class="fas fa-trash"></i>
                      </button>
                    </form>
                  </div>
                </td>
              </tr>
              <% }) %>
            </tbody>
          </table>
        </div>

        <!-- Table Footer -->
        <div style="padding:14px 20px;border-top:1px solid #f1f5f9;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:8px;">
          <span style="font-size:12.5px;color:#64748b;">
            Showing <strong><%= employees.length %></strong> employee(s)
            <% if (search) { %> for "<strong><%= search %></strong>"<% } %>
          </span>
          <div style="display:flex;gap:6px;font-size:12px;color:#94a3b8;">
            <span><i class="fas fa-mouse-pointer"></i>Click a row to see the details.</span>
          </div>
        </div>

        <% } else { %>
        <div class="empty-state">
          <i class="fas fa-user-slash"></i>
          <h4>No employee found</h4>
          <p>
            <% if (search) { %>
              "<%= search %>" No results found for.
              <a href="/employees" style="color:#6366f1;">Clear filter</a>
            <% } else { %>
              No employee has been added yet.
            <% } %>
          </p>
          <% if (!search) { %>
          <a href="/employees/add" class="btn btn-primary" style="margin-top:16px;">
            <i class="fas fa-plus"></i> Add the first employee
          </a>
          <% } %>
        </div>
        <% } %>

      </div><!-- /table-wrapper -->
    </div><!-- /content-area -->
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="/js/script.js"></script>
</body>
</html>
