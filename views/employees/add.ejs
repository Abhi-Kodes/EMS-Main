<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Add Employee — EMS Pro</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
<div class="wrapper">

  <%- include('../partials/sidebar') %>

  <div class="main-content">
    <%- include('../partials/topbar') %>

    <div class="content-area">

      <div class="page-header">
        <div class="page-header-left">
          <h1>Add <span>New Employee</span></h1>
          <p>Add a new employee by completing all the required fields ✅</p>
        </div>
        <a href="/employees" class="btn btn-secondary">
          <i class="fas fa-arrow-left"></i> Back
        </a>
      </div>

      <div class="row justify-content-center">
        <div class="col-xl-9 col-lg-11">
          <div class="form-wrapper">

            <div class="form-header">
              <div class="form-header-icon"><i class="fas fa-user-plus"></i></div>
              <div>
                <h4>Employee Information</h4>
                <p>Enter all the details below. Fields marked with * are mandatory</p>
              </div>
            </div>

            <form action="/employees/add" method="POST" class="form-body" id="addForm">

              <!-- Personal Info -->
              <div class="form-section-title">Personal Information</div>

              <div class="row g-3 mb-3">
                <div class="col-md-6">
                  <label class="form-label">First Name <span class="req">*</span></label>
                  <input type="text" name="first_name" class="form-control" placeholder="Rahul" required>
                </div>
                <div class="col-md-6">
                  <label class="form-label">Last Name <span class="req">*</span></label>
                  <input type="text" name="last_name" class="form-control" placeholder="Sharma" required>
                </div>
              </div>

              <div class="row g-3 mb-3">
                <div class="col-md-6">
                  <label class="form-label">Email Address <span class="req">*</span></label>
                  <input type="email" name="email" class="form-control" placeholder="rahul@company.com" required>
                </div>
                <div class="col-md-6">
                  <label class="form-label">Phone Number</label>
                  <input type="tel" name="phone" class="form-control" placeholder="9876543210" maxlength="10">
                </div>
              </div>

              <div class="row g-3 mb-3">
                <div class="col-md-6">
                  <label class="form-label">Gender</label>
                  <select name="gender" class="form-select">
                    <option value="male">Male</option>
                    <option value="female">Female</option>
                    <option value="other">Other</option>
                  </select>
                </div>
                <div class="col-md-6">
                  <label class="form-label">Address</label>
                  <input type="text" name="address" class="form-control" placeholder="City, State">
                </div>
              </div>

              <!-- Job Info -->
              <div class="form-section-title mt-3">Job Information</div>

              <div class="row g-3 mb-3">
                <div class="col-md-6">
                  <label class="form-label">Department</label>
                  <select name="department_id" class="form-select">
                    <option value="">-- Select Department --</option>
                    <% departments.forEach(dept => { %>
                      <option value="<%= dept.id %>"><%= dept.name %></option>
                    <% }) %>
                  </select>
                </div>
                <div class="col-md-6">
                  <label class="form-label">Designation / Role</label>
                  <input type="text" name="designation" class="form-control" placeholder="e.g. Senior Developer">
                </div>
              </div>

              <div class="row g-3 mb-3">
                <div class="col-md-6">
                  <label class="form-label">Monthly Salary (₹)</label>
                  <div style="position:relative;">
                    <span style="position:absolute;left:12px;top:50%;transform:translateY(-50%);color:#64748b;font-weight:600;">₹</span>
                    <input type="number" name="salary" id="salaryInput" class="form-control" placeholder="50000" min="0" style="padding-left:28px;">
                  </div>
                </div>
                <div class="col-md-6">
                  <label class="form-label">Join Date</label>
                  <input type="date" name="join_date" class="form-control" value="<%= new Date().toISOString().split('T')[0] %>">
                </div>
              </div>

              <div class="row g-3 mb-3">
                <div class="col-md-6">
                  <label class="form-label">Status</label>
                  <select name="status" class="form-select">
                    <option value="active">✅ Active</option>
                    <option value="inactive">❌ Inactive</option>
                  </select>
                </div>
              </div>

            </form>

            <div class="form-footer">
              <button type="submit" form="addForm" class="btn btn-primary">
                <i class="fas fa-save"></i> Save Employee
              </button>
              <a href="/employees" class="btn btn-secondary">
                <i class="fas fa-times"></i> Cancel
              </a>
              <span style="font-size:12px;color:#94a3b8;margin-left:auto;">
                <i class="fas fa-info-circle"></i> Employee ID is automatically generated
              </span>
            </div>

          </div>
        </div>
      </div>

    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="/js/script.js"></script>
</body>
</html>
