<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= employee.first_name %> <%= employee.last_name %> — EMS Pro</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
<div class="wrapper">

  <%- include('../partials/sidebar') %>

  <div class="main-content">
    <%- include('../partials/topbar') %>

    <div class="content-area">

      <div class="page-header">
        <div class="page-header-left">
          <h1>Employee <span>Profile</span></h1>
          <p>Full details — <%= employee.emp_id %></p>
        </div>
        <div style="display:flex;gap:10px;">
          <a href="/employees/edit/<%= employee.id %>" class="btn btn-primary btn-sm">
            <i class="fas fa-pen"></i> Edit
          </a>
          <a href="/employees" class="btn btn-secondary btn-sm">
            <i class="fas fa-arrow-left"></i> Back
          </a>
        </div>
      </div>

      <div class="row justify-content-center">
        <div class="col-xl-8 col-lg-10">

          <!-- Profile Card -->
          <div class="form-wrapper">

            <!-- Header -->
            <div class="profile-header">
              <div class="profile-avatar-lg" data-name="<%= employee.first_name %> <%= employee.last_name %>">
                <%= employee.first_name[0] %><%= employee.last_name[0] %>
              </div>
              <div class="profile-info">
                <h2><%= employee.first_name %> <%= employee.last_name %></h2>
                <p><%= employee.designation || 'Employee' %> &nbsp;•&nbsp; <%= employee.dept_name || 'No Department' %></p>
                <div style="display:flex;align-items:center;gap:10px;margin-top:10px;flex-wrap:wrap;">
                  <span class="emp-id-badge" style="background:rgba(255,255,255,0.2);color:white;border:1px solid rgba(255,255,255,0.3);">
                    <%= employee.emp_id %>
                  </span>
                  <span class="status-pill <%= employee.status %>" style="cursor:default;">
                    <%= employee.status %>
                  </span>
                </div>
              </div>
            </div>

            <!-- Info Grid -->
            <div class="info-grid">
              <div class="info-item">
                <div class="info-label"><i class="fas fa-envelope" style="margin-right:5px;color:#6366f1;"></i>Email</div>
                <div class="info-value"><%= employee.email %></div>
              </div>
              <div class="info-item">
                <div class="info-label"><i class="fas fa-phone" style="margin-right:5px;color:#22c55e;"></i>Phone</div>
                <div class="info-value"><%= employee.phone || '—' %></div>
              </div>
              <div class="info-item">
                <div class="info-label"><i class="fas fa-building" style="margin-right:5px;color:#f59e0b;"></i>Department</div>
                <div class="info-value"><%= employee.dept_name || '—' %></div>
              </div>
              <div class="info-item">
                <div class="info-label"><i class="fas fa-briefcase" style="margin-right:5px;color:#06b6d4;"></i>Designation</div>
                <div class="info-value"><%= employee.designation || '—' %></div>
              </div>
              <div class="info-item">
                <div class="info-label"><i class="fas fa-indian-rupee-sign" style="margin-right:5px;color:#10b981;"></i>Monthly Salary</div>
                <div class="info-value salary-text">₹<%= employee.salary ? Number(employee.salary).toLocaleString('en-IN') : '0' %></div>
              </div>
              <div class="info-item">
                <div class="info-label"><i class="fas fa-calendar" style="margin-right:5px;color:#8b5cf6;"></i>Join Date</div>
                <div class="info-value">
                  <%= employee.join_date ? new Date(employee.join_date).toLocaleDateString('en-IN', {day:'2-digit',month:'long',year:'numeric'}) : '—' %>
                </div>
              </div>
              <div class="info-item">
                <div class="info-label"><i class="fas fa-venus-mars" style="margin-right:5px;color:#f43f5e;"></i>Gender</div>
                <div class="info-value" style="text-transform:capitalize;"><%= employee.gender || '—' %></div>
              </div>
              <div class="info-item">
                <div class="info-label"><i class="fas fa-map-marker-alt" style="margin-right:5px;color:#ef4444;"></i>Address</div>
                <div class="info-value"><%= employee.address || '—' %></div>
              </div>
            </div>

            <!-- Footer Actions -->
            <div class="form-footer">
              <a href="/employees/edit/<%= employee.id %>" class="btn btn-primary">
                <i class="fas fa-pen"></i> Edit Employee
              </a>
              <a href="/employees" class="btn btn-secondary">
                <i class="fas fa-list"></i> All Employees
              </a>
              <form
                action="/employees/delete/<%= employee.id %>?_method=DELETE"
                method="POST"
                class="delete-form"
                data-name="<%= employee.first_name %> <%= employee.last_name %>"
                style="margin-left:auto;"
              >
                <button type="submit" class="btn btn-danger btn-sm">
                  <i class="fas fa-trash"></i> Delete Employee
                </button>
              </form>
            </div>

          </div><!-- /form-wrapper -->

          <!-- Meta Info -->
          <div style="margin-top:14px;padding:0 4px;display:flex;justify-content:space-between;flex-wrap:wrap;gap:6px;">
            <span style="font-size:12px;color:#94a3b8;">
              <i class="fas fa-clock"></i> Added:
              <%= employee.created_at ? new Date(employee.created_at).toLocaleDateString('en-IN',{day:'2-digit',month:'short',year:'numeric'}) : '—' %>
            </span>
            <span style="font-size:12px;color:#94a3b8;">
              <i class="fas fa-sync"></i> Updated:
              <%= employee.updated_at ? new Date(employee.updated_at).toLocaleDateString('en-IN',{day:'2-digit',month:'short',year:'numeric'}) : '—' %>
            </span>
          </div>

        </div>
      </div>

    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="/js/script.js"></script>
</body>
</html>
